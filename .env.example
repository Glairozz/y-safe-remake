# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the Express server listens on (default 3000).
PORT=3000

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Password for the admin console at /admin-login.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. SQLite database location.
# Defaults to ./database.sqlite locally and /tmp/database.sqlite on Vercel.
DATABASE_PATH=
